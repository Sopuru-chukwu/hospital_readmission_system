# DiaPredict.AI Production Environment Configuration Example
# Copy this file to .env and replace secrets before deploying to hospital production environment

# Application Settings
ENV=production
PROJECT_NAME="DiaPredict.AI Hospital Readmission System"
API_V1_STR=/api/v1

# Security & JWT Token Generation (Replace with a strong randomly generated key in production)
# Command to generate: openssl rand -hex 32
SECRET_KEY=e8391b4a92c30f7e15d862e49c0d18f52a71408b3e9a712f56711904a11b6528
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days

# PostgreSQL Production Database Credentials
POSTGRES_USER=diapredict_admin
POSTGRES_PASSWORD=HARDENED_STRONG_DB_PASSWORD_HERE
POSTGRES_DB=hospital_readmission
DATABASE_URL=postgresql://diapredict_admin:HARDENED_STRONG_DB_PASSWORD_HERE@db:5432/hospital_readmission

# Allowed CORS Origins (Comma-separated list or JSON array of hospital domains)
BACKEND_CORS_ORIGINS=["https://diapredict.hospital.ng","https://app.diapredict.ai"]
